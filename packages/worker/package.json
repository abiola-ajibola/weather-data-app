{
  "name": "@weather-data-app/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "yarn workspace @weather-data-app/database build && tsx watch src/index.ts",
    "build": "yarn workspace @weather-data-app/database build && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "convert:iso-table": "tsx src/lib/convert-iso-table.ts",
    "convert:iso-table:json": "tsx src/lib/convert-iso-table-json.ts",
    "ingest:url": "yarn build && node dist/ingest_url.js",
    "ingest:url:dev": "yarn workspace @weather-data-app/database build && tsx src/ingest_url.ts",
    "ingest:file": "yarn build && node dist/ingest_file.js",
    "ingest:file:dev": "yarn workspace @weather-data-app/database build && tsx src/ingest_file.ts"
  },
  "dependencies": {
    "@weather-data-app/database": "workspace:*",
    "cheerio": "^1.2.0",
    "csv-parse": "^6.2.1",
    "log-update": "^8.0.0",
    "minimist": "^1.2.8",
    "yoctocolors": "^2.1.2"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
